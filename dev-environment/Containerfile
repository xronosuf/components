FROM node:22-bookworm

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       curl \
       dvisvgm \
       git \
       make \
       python3 \
       texlive-base \
       texlive-binaries \
       texlive-latex-base \
       texlive-latex-extra \
       texlive-latex-recommended \
       texlive-fonts-recommended \
       texlive-pictures \
       texlive-science \
    && rm -rf /var/lib/apt/lists/*

# This image is intended to run under rootless Podman. On the UF test host,
# processes using the image's non-root `node` UID cannot execute binaries from
# the rootless container storage, while container UID 0 works normally.
# In rootless Podman, container UID 0 maps to the invoking unprivileged host
# user; it does not grant host-root privileges.
RUN mkdir -p /workspace

USER root
WORKDIR /workspace

CMD ["bash"]
