FROM node:22-trixie

ENV DEBIAN_FRONTEND=noninteractive
ENV TEXLIVE_YEAR=2026
ENV TEXLIVE_ROOT=/usr/local/texlive/2026
ENV PATH=/usr/local/texlive/2026/bin/x86_64-linux:$PATH

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       curl \
       git \
       make \
       perl \
       python3 \
       tar \
       xz-utils \
    && rm -rf /var/lib/apt/lists/*

# TeX is accessibility-critical for this project. Do not rely on Debian's
# bundled TeX Live snapshot: the development environment requires TeX Live
# 2026 (and therefore a distribution newer than 2025-10-31). Install the
# official upstream TeX Live release into its year-qualified prefix, then add
# the Ximera/tex4ht collections required by the compatibility corpus.
RUN set -eux; \
    cd /tmp; \
    curl -fsSL -o install-tl-unx.tar.gz \
      https://mirror.ctan.org/systems/texlive/tlnet/install-tl-unx.tar.gz; \
    tar -xzf install-tl-unx.tar.gz; \
    installer_dir="$(find /tmp -maxdepth 1 -type d -name 'install-tl-*' | head -n 1)"; \
    perl "$installer_dir/install-tl" \
      --no-interaction \
      --scheme=scheme-small \
      --no-doc-install \
      --no-src-install \
      --texdir="$TEXLIVE_ROOT"; \
    "$TEXLIVE_ROOT/bin/x86_64-linux/tlmgr" install \
      collection-fontsrecommended \
      collection-latexextra \
      collection-mathscience \
      collection-pictures \
      collection-plaingeneric \
      collection-pstricks \
      dvisvgm \
      tex4ht; \
    rm -rf /tmp/install-tl-* /tmp/install-tl-unx.tar.gz; \
    kpsewhich --version | head -n 1; \
    pdflatex --version | head -n 1; \
    tex4ht --version 2>&1 | head -n 3 || true; \
    dvisvgm --version | head -n 1

# Debian's /etc/profile resets PATH for login shells. Our Podman helpers use
# `bash -lc`, so persist the TeX Live prefix through /etc/profile.d as well as
# the image-level ENV above. This keeps the official TeX Live 2026 toolchain
# active in both ordinary processes and login-shell diagnostics/builds.
RUN printf '%s\n' \
      'export PATH=/usr/local/texlive/2026/bin/x86_64-linux:$PATH' \
      > /etc/profile.d/texlive.sh \
    && chmod 0644 /etc/profile.d/texlive.sh

# This image is intended to run under rootless Podman. On the UF test host,
# processes using the image's non-root `node` UID cannot execute binaries from
# the rootless container storage, while container UID 0 works normally.
# In rootless Podman, container UID 0 maps to the invoking unprivileged host
# user; it does not grant host-root privileges.
RUN mkdir -p /workspace

USER root
WORKDIR /workspace

CMD ["bash"]
