FROM node:22-trixie

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       curl \
       dvisvgm \
       git \
       make \
       python3 \
       texlive-base \
       texlive-binaries \
       texlive-latex-base \
       texlive-latex-extra \
       texlive-latex-recommended \
       texlive-fonts-recommended \
       texlive-pictures \
       texlive-pstricks \
       texlive-science \
    && rm -rf /var/lib/apt/lists/*

# Use Debian Trixie rather than Bookworm so the development image carries a
# current tex4ht/TeX Live stack. The split @ximera/answer postprocessor relies
# on tex4ht's MathJax wrapper elements (mathjax-inline/mathjax-block), behavior
# that is present in current TeX Live but absent from the Bookworm TeX Live 2022
# packages. Keep this build environment close to the current upstream Ximera
# development toolchain rather than compensating for old tex4ht output in the
# component runtime.

# This image is intended to run under rootless Podman. On the UF test host,
# processes using the image's non-root `node` UID cannot execute binaries from
# the rootless container storage, while container UID 0 works normally.
# In rootless Podman, container UID 0 maps to the invoking unprivileged host
# user; it does not grant host-root privileges.
RUN mkdir -p /workspace

USER root
WORKDIR /workspace

CMD ["bash"]
